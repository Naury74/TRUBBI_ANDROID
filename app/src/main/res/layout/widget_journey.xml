<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_journey_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_white"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 헤더: 경로 요약 + 누적 거리 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/journey_route"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_active_journey"
            android:textColor="#9097A0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/journey_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#9097A0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 현재 정차지 -->
    <TextView
        android:id="@+id/journey_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_journey_info"
        android:textColor="#16181C"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- 종류 · 단계 -->
    <TextView
        android:id="@+id/journey_phase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <!-- 액션 버튼 — 단계 넘기기 외에 촬영/열기도 명확하게 -->
    <LinearLayout
        android:id="@+id/journey_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="@string/widget_next_step"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btn_camera"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_dark"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_widget_camera"
                android:contentDescription="@string/widget_capture" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/widget_capture"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="0.8"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_neutral"
            android:gravity="center"
            android:text="@string/widget_open"
            android:textColor="#16181C"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
